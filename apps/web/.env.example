# Copy this file to .env (in this same folder) only if you need it.
# Careful! Everything starting with VITE_ ends up in the public JavaScript:
# never put a key or a secret here.

# API URL. Leave it empty locally: Vite forwards /api to localhost:3000.
# On Render: the public API URL, e.g. https://press-start-quest-api.onrender.com
VITE_API_URL=
