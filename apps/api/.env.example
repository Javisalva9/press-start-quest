# Copy this file to .env (in this same folder) and fill in the values.
# .env is NEVER pushed to GitHub; this .env.example is, but without real values.

# --- Database (Neon) ---
# Use sslmode=verify-full in both URLs: encrypted, and checks it's really Neon.
# "Pooled" connection (-pooler in the host): used by the API at runtime.
DATABASE_URL=
# Direct connection (no -pooler): used by Prisma for migrations.
DATABASE_URL_DIRECT=

# --- Server ---
PORT=3000
# Web URL allowed to call the API (several, comma-separated).
CORS_ORIGIN=http://localhost:5173
# Web app URL: Steam sends users back there after they sign in.
WEB_URL=http://localhost:5173

# --- Sessions. Generate each secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Protects POST /api/internal/jobs/daily (stage 2).
JOBS_TOKEN=

# --- External service keys ---
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ITAD_API_KEY=
