# Copia este archivo como .env (en esta misma carpeta) y rellena los valores.
# El .env NUNCA se sube a GitHub; este .env.example sí, pero sin valores reales.

# --- Base de datos (Neon) ---
# Conexión "pooled" (con -pooler en el host): la usa la API en tiempo de ejecución.
DATABASE_URL=
# Conexión directa (sin -pooler): la usa Prisma para las migraciones.
DATABASE_URL_DIRECT=

# --- Servidor ---
PORT=3000
# URL de la web que puede llamar a la API (varias separadas por comas).
CORS_ORIGIN=http://localhost:5173
# URL pública de la API (Steam te devuelve aquí tras iniciar sesión). Etapa 1.
PUBLIC_API_URL=http://localhost:3000

# --- Sesiones (etapa 1). Genera cada una con: openssl rand -base64 48 ---
JWT_SECRET=
JWT_REFRESH_SECRET=
# Protege POST /api/internal/jobs/daily (etapa 2).
JOBS_TOKEN=

# --- Claves de servicios externos ---
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ITAD_API_KEY=
