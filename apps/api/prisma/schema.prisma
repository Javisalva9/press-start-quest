generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // the URL lives in prisma.config.ts
}

enum Platform {
  STEAM
  EPIC
  EXTERNAL
}

enum GameStatus {
  BACKLOG
  PLAYING
  COMPLETED
  ABANDONED
  ON_HOLD
  WISHLIST
  DISCARDED
}

enum StatusSource {
  AUTO
  MANUAL
}

// Why a game looks finished, shown on its confirmation card.
enum CompletionSignal {
  ALL_ACHIEVEMENTS
  FINALE_ACHIEVEMENT
  PLAYTIME
}

enum GameType {
  COMPLETABLE
  ENDLESS
  SANDBOX
  UNKNOWN
}

enum ServerStatus {
  ONLINE
  ANNOUNCED
  PARTIAL
  CLOSED
  UNKNOWN
}

// What a store entry really is: only GAME shows up in the library.
enum GameKind {
  GAME
  DLC
  DEMO
  SOUNDTRACK
  TOOL
  PLAYTEST
}

enum TagKind {
  GENRE
  THEME
  MODE
  PERSPECTIVE
  STORE_CATEGORY
}

enum CuratorKind {
  FRIEND
  CREATOR
}

enum FeedbackAction {
  ACCEPTED
  NOT_NOW
  NEVER
  IGNORED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model User {
  id                   String                  @id @default(cuid())
  email                String?                 @unique
  displayName          String
  locale               String                  @default("en") // en | es
  settings             Json                    @default("{}")
  createdAt            DateTime                @default(now())
  sources              Source[]
  games                UserGame[]
  curators             Curator[] // own friends (FRIEND)
  follows              UserCurator[] // creators they follow (CREATOR)
  tasteScores          TasteScore[]
  recommendationEvents RecommendationEvent[]
  syncJobs             SyncJob[]
  sessions             Session[]
  finaleVotes          AchievementFinaleVote[]

  @@map("users")
}

// A signed-in device. The refresh token itself is never stored, only its
// SHA-256: a database leak doesn't let anyone resume a session.
model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  // Hash of the token this one replaced, to spot a stolen token being reused.
  previousTokenHash String?   @unique
  rotatedAt         DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Source {
  id          String      @id @default(cuid())
  userId      String
  platform    Platform
  externalId  String // SteamID, Epic account or generated id for external sources
  displayName String? // "Jack Sparrow" for external sources
  lastSyncAt  DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerships  Ownership[]

  @@unique([platform, externalId])
  @@map("sources")
}

model Game {
  id                   String                @id @default(cuid())
  title                String
  slug                 String                @unique
  igdbId               Int?                  @unique
  steamAppId           Int?                  @unique
  epicCatalogId        String?               @unique
  // IsThereAnyDeal's id (a UUID), found from the Steam appid for prices.
  itadId               String?               @unique
  kind                 GameKind              @default(GAME)
  coverUrl             String?
  heroUrl              String?
  summary              String?
  releaseDate          DateTime?
  developer            String?
  rating               Float? // 0-100
  ratingCount          Int?
  metacritic           Int?
  steamReviewPct       Int?
  ttbMainMin           Int?
  ttbExtraMin          Int?
  ttbCompleteMin       Int?
  ttbSource            String? // igdb | hltb | manual
  gameType             GameType              @default(UNKNOWN)
  serverStatus         ServerStatus          @default(UNKNOWN)
  serverClosedAt       DateTime?
  metadataAt           DateTime?
  userGames            UserGame[]
  tags                 GameTag[]
  curatorPicks         CuratorPick[]
  deal                 Deal?
  recommendationEvents RecommendationEvent[]
  achievements         Achievement[]

  @@map("games")
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String
  kind        TagKind
  games       GameTag[]
  tasteScores TasteScore[]

  @@unique([name, kind])
  @@map("tags")
}

model GameTag {
  gameId String
  tagId  Int
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@map("game_tags")
}

model UserGame {
  id                   String             @id @default(cuid())
  userId               String
  gameId               String
  status               GameStatus         @default(BACKLOG)
  statusSource         StatusSource       @default(AUTO)
  completionConfidence Float?
  completionSignal     CompletionSignal?
  // The player's last "no, not finished" on the confirmation queue, and
  // the signal it answered: the card only comes back with a stronger one.
  reviewedAt           DateTime?
  reviewedSignal       CompletionSignal?
  owned                Boolean            @default(true)
  wishlistPriority     Int?
  wishlistedAt         DateTime?
  playtimeMin          Int                @default(0)
  lastPlayedAt         DateTime?
  achievementsUnlocked Int?
  achievementsTotal    Int?
  completedAt          DateTime?
  // The player's stars in half stars, 1–10: 3.5 stars is 7 (common/stars.ts).
  personalRating       Int?
  goal                 String?
  notes                String?
  typeOverride         GameType?
  serverOverride       ServerStatus?
  hidden               Boolean            @default(false)
  snoozedUntil         DateTime?
  addedManually        Boolean            @default(false)
  // The curator whose list brought it to "Lo quiero": unfollowing removes
  // the ones still untouched.
  addedByCuratorId     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                 Game               @relation(fields: [gameId], references: [id])
  ownerships           Ownership[]
  snapshots            PlaytimeSnapshot[]
  achievements         UserAchievement[]

  addedByCurator Curator? @relation(fields: [addedByCuratorId], references: [id], onDelete: SetNull)

  @@unique([userId, gameId])
  @@index([addedByCuratorId])
  @@index([userId, status])
  @@map("user_games")
}

model Ownership {
  id            String    @id @default(cuid())
  userGameId    String
  sourceId      String
  externalAppId String
  playtimeMin   Int       @default(0)
  playtime2wMin Int       @default(0)
  lastPlayedAt  DateTime?
  userGame      UserGame  @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalAppId])
  @@map("ownerships")
}

// A game's achievements, shared by every player: the catalog, like games.
// Read in English, so a name can tell a "finish the game" achievement.
model Achievement {
  id                     String                  @id @default(cuid())
  gameId                 String
  platform               Platform
  // The store's own id (Steam's apiname): unique within a game and store.
  externalId             String
  name                   String
  description            String
  // A "finish the game" achievement according to the phrase rules
  // (catalog/finale-achievement.ts), kept up to date on every sync.
  finaleByRule           Boolean                 @default(false)
  game                   Game                    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  unlocks                UserAchievement[]
  achievementFinaleVotes AchievementFinaleVote[]

  @@unique([gameId, platform, externalId])
  @@map("achievements")
}

// A player's say on whether an achievement marks the end of its game, for
// the ones the phrase rules miss (hidden achievements) or get wrong. Their
// own vote wins for them; enough agreeing votes win for everyone else.
model AchievementFinaleVote {
  userId        String
  achievementId String
  isFinale      Boolean
  votedAt       DateTime    @default(now()) @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([achievementId])
  @@map("achievement_finale_votes")
}

// The achievements a player unlocked. A locked one has no row.
model UserAchievement {
  userGameId    String
  achievementId String
  unlockedAt    DateTime
  userGame      UserGame    @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userGameId, achievementId])
  @@index([achievementId])
  @@map("user_achievements")
}

model PlaytimeSnapshot {
  id          String   @id @default(cuid())
  userGameId  String
  date        DateTime @db.Date
  playtimeMin Int
  userGame    UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  @@unique([userGameId, date])
  @@map("playtime_snapshots")
}

model Curator {
  id         String        @id @default(cuid())
  userId     String? // empty = global creator (CREATOR); set = that user's friend (FRIEND)
  name       String
  kind       CuratorKind   @default(FRIEND)
  color      String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks      CuratorPick[]
  followers  UserCurator[]
  addedGames UserGame[]

  @@unique([userId, name]) // + partial index in the migration: unique name among global creators
  @@map("curators")
}

model UserCurator {
  userId     String
  curatorId  String
  followedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  curator    Curator  @relation(fields: [curatorId], references: [id], onDelete: Cascade)

  @@id([userId, curatorId])
  @@map("user_curators")
}

model CuratorPick {
  id        String   @id @default(cuid())
  curatorId String
  gameId    String
  note      String?
  createdAt DateTime @default(now())
  curator   Curator  @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id])

  @@unique([curatorId, gameId])
  @@map("curator_picks")
}

model TasteScore {
  userId    String
  tagId     Int
  score     Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@map("taste_scores")
}

model RecommendationEvent {
  id      String         @id @default(cuid())
  userId  String
  gameId  String
  score   Float
  reasons Json
  mood    String?
  action  FeedbackAction @default(IGNORED)
  shownAt DateTime       @default(now())
  actedAt DateTime?
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  game    Game           @relation(fields: [gameId], references: [id])

  @@map("recommendation_events")
}

// The best current price of a game in the official stores (data/official-
// stores.json), from IsThereAnyDeal, in euros for Spain. One row per
// game, refreshed every night for the games someone wants ("Lo quiero").
model Deal {
  id              String    @id @default(cuid())
  gameId          String    @unique
  store           String
  price           Decimal   @db.Decimal(8, 2)
  regularPrice    Decimal   @db.Decimal(8, 2)
  cutPct          Int
  currency        String    @default("EUR")
  url             String
  isHistoricalLow Boolean   @default(false)
  // Lowest price ever in those stores, and when.
  lowestPrice     Decimal?  @db.Decimal(8, 2)
  lowestAt        DateTime?
  expiresAt       DateTime?
  fetchedAt       DateTime  @default(now())
  game            Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("deals")
}

model SyncJob {
  id         String    @id @default(cuid())
  userId     String
  status     JobStatus @default(QUEUED)
  progress   Int       @default(0)
  stats      Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  // Last time the job wrote anything (progress or its 30 s heartbeat). An
  // active job silent for 2 minutes is treated as dead, whichever process ran it.
  updatedAt  DateTime  @default(now()) @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // + partial unique index in the migration: one QUEUED or RUNNING job per user.
  // If `prisma migrate dev` ever proposes dropping sync_jobs_one_active_per_user,
  // delete that line from the generated migration.
  @@map("sync_jobs")
}
